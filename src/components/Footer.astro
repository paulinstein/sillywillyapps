---
import { Image } from 'astro:assets';
import monogram from '../../brand/logo/monogram.png';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <Image src={monogram} alt="" width={40} densities={[1, 2]} />
  <p>
    <a href="/rss.xml">RSS</a> · <a href="/privacy/">Privacy</a> · © {year} Silly Willy Apps
  </p>
  <p class="muted small">No ads. Just fun things I like making.</p>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    padding: 24px 16px 32px;
    text-align: center;
    font-size: 14px;
  }
  .site-footer img { display: block; margin: 0 auto 8px; transform: rotate(-3deg); }
  .site-footer p { margin: 0 0 4px; }
  .small { font-size: 13px; }
</style>
